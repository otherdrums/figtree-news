{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Figtree-News sources.json",
  "description": "Single unified configuration file for Figtree-News: sources, feeds, SearXNG, and crawler state.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/definitions/source"
  },
  "definitions": {
    "source": {
      "type": "object",
      "description": "A news source with identity and base trust",
      "required": ["name", "base_trust"],
      "properties": {
        "name": { "type": "string", "description": "Display name" },
        "base_trust": { "type": "number", "minimum": 0, "maximum": 1, "description": "Initial trust score (0–1)" },
        "url": { "type": "string", "format": "uri", "description": "Homepage URL" },
        "kind": { "type": "string", "enum": ["news", "blog", "social", "official", "video"], "description": "Source kind" },
        "logo_url": { "type": "string", "format": "uri", "description": "Favicon/logo URL" }
      }
    },
    "feeds": {
      "type": "object",
      "description": "Map of source_id → RSS/Atom feed URL or YouTube video feed",
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "seeds": {
      "type": "array",
      "description": "Seed URLs for BFS crawling",
      "items": { "type": "string", "format": "uri" }
    },
    "searxng": {
      "type": "object",
      "description": "SearXNG search engine settings",
      "properties": {
        "url": { "type": "string", "format": "uri", "description": "SearXNG instance URL" },
        "enabled": { "type": "boolean", "description": "Enable SearXNG searches during crawl" },
        "categories": { "type": "string", "description": "Search category (news, general, etc.)" },
        "time_range": { "type": "string", "description": "Time range filter (day, week, month, year)" },
        "language": { "type": "string", "description": "Language filter" },
        "max_results": { "type": "integer", "minimum": 1, "description": "Results per query" },
        "pages": { "type": "integer", "minimum": 1, "description": "Number of result pages" },
        "timeout": { "type": "integer", "minimum": 1, "description": "Request timeout in seconds" }
      }
    },
    "crawler": {
      "type": "object",
      "description": "Persisted crawler state (auto-saved after each tick)",
      "properties": {
        "continuous": { "type": "boolean", "description": "Start continuous crawl on server startup" },
        "smart_crawl": { "type": "boolean", "description": "Skip feeds that have been empty in recent ticks" },
        "interval": { "type": ["string", "integer"], "description": "Tick interval in seconds" },
        "max_articles": { "type": "integer", "minimum": 1, "description": "Max articles per tick" },
        "max_stories": { "type": "integer", "minimum": 0, "description": "Max stories to track (0 = unlimited)" },
        "llm_enabled": { "type": "boolean", "description": "DEPRECATED — external LLM stack removed" },
        "searxng_enabled": { "type": "boolean", "description": "DEPRECATED — use searxng.enabled" },
        "searxng_time_range": { "type": "string", "description": "DEPRECATED — use searxng.time_range" },
        "searxng_categories": { "type": "string", "description": "DEPRECATED — use searxng.categories" },
        "mode": { "type": "string", "enum": ["forward", "backward"], "description": "Crawl direction" },
        "consecutive_empty_ticks": { "type": "integer", "minimum": 0, "description": "Consecutive ticks with 0 new articles" },
        "last_run": { "type": ["string", "null"], "format": "date-time", "description": "ISO timestamp of last crawl" },
        "backward_time_range": { "type": "string", "description": "Time range for backward crawl" }
      }
    }
  },
  "properties": {
    "feeds": { "$ref": "#/definitions/feeds" },
    "seeds": { "$ref": "#/definitions/seeds" },
    "searxng": { "$ref": "#/definitions/searxng" },
    "crawler": { "$ref": "#/definitions/crawler" }
  }
}
